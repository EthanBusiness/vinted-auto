# ============================================================
#  Réglages du site. Ce fichier s'appelle ".env" sur ton PC.
#  Ne le partage jamais : il contient tes clés.
# ============================================================

# --- Identifiants pour se connecter au site ---
# Toi (accès complet)
ADMIN_USER=ethan
ADMIN_PASSWORD=change-moi
# Ton employée (seulement la file des photos)
EMPLOYEE_USER=photos
EMPLOYEE_PASSWORD=change-moi-aussi

# --- Clé API Claude (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=

# --- Clé API Scalency (Scalency > Paramètres > Clé API) ---
# Facultatif à l'étape 2 : sert à afficher la liste de tes comptes Vinted.
SCALENCY_API_KEY=

# --- Divers (tu peux laisser tel quel) ---
# Taux pour afficher les coûts en euros
EUR_PAR_USD=0.92
# Port du site : http://localhost:8000
PORT=8000
